# Salin file ini jadi .env lalu isi nilainya.
# Ganti YOUR_PASSWORD dengan password user postgres di mesin kamu.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/erp_db?schema=public"

PORT=3001
CORS_ORIGIN=http://localhost:3000

# Ganti dengan string acak panjang (misal: bunx --bun node -e "console.log(crypto.randomUUID()+crypto.randomUUID())")
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Interval posting jurnal otomatis (ms). 0 = mati (jurnal tetap diposting saat laporan akuntansi dibuka).
JOURNAL_SYNC_INTERVAL_MS=60000
